{
  "name": "screenshot-composer",
  "version": "0.2.0",
  "description": "Compose Google Play Store screenshots from Android app screenshots",
  "keywords": [
    "google-play",
    "play-store",
    "screenshots",
    "android",
    "app-store-optimization",
    "aso",
    "device-frames",
    "cli",
    "playwright",
    "sharp"
  ],
  "homepage": "https://github.com/tajchert/screenshot-composer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tajchert/screenshot-composer.git"
  },
  "bugs": {
    "url": "https://github.com/tajchert/screenshot-composer/issues"
  },
  "author": "Michal Tajchert",
  "type": "module",
  "license": "MIT AND Apache-2.0",
  "engines": { "node": ">=20" },
  "bin": { "screenshot-composer": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build-finalize.mjs",
    "prepack": "npm run typecheck && npm run build",
    "smoke": "node scripts/smoke-pack.mjs",
    "cli": "tsx src/cli.ts",
    "frames:import": "tsx src/frames/_build/import-aosp.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8",
    "jiti": "^2.4.2",
    "sharp": "^0.33.5",
    "playwright": "^1.49.1",
    "execa": "^9.5.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2"
  }
}
